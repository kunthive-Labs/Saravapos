{
  "name": "@saravapos/cli",
  "version": "0.1.0-alpha.0",
  "description": "Saravapos translation CLI — translate ideas between mental models",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "saravapos": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@saravapos/adapters": "workspace:*",
    "@saravapos/sdk": "workspace:*",
    "@saravapos/spec": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
